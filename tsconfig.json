{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "chrome"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "extension/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
