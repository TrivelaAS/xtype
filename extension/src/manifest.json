{
  "manifest_version": 3,
  "name": "XType — Human X.com Typer",
  "version": "1.0.0",
  "description": "Emulates realistic human typing on X.com posts, replies, reposts, and quote posts inside an open unfocused Chrome window.",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XType Controller"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "http://127.0.0.1/mock-x*",
        "http://localhost/mock-x*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
