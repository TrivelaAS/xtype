{
  "manifest_version": 3,
  "name": "Typed PostX",
  "version": "0.1.0",
  "description": "Local X composer helper using Windows key events.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://x.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Typed PostX"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
